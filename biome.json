{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"windows/src/ui/app.js",
			"backend/worker.js"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"recommended": false
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"useIterableCallbackReturn": "off"
			},
			"correctness": {
				"noInnerDeclarations": "off",
				"noUnusedFunctionParameters": "off",
				"noUnusedVariables": "warn"
			},
			"complexity": {
				"useOptionalChain": "off"
			}
		}
	}
}
