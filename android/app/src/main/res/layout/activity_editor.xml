<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Top Action Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand"
        app:title="@string/app_name"
        app:titleTextColor="@color/surface"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

    <!-- Meta / Header Row: Folder Badge + Word Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General"
            app:chipIcon="@drawable/ic_folder"
            app:chipIconTint="@color/brand"
            app:chipBackgroundColor="@color/brand_light"
            android:textColor="@color/brand_dark"
            app:chipStrokeWidth="0dp"
            android:textSize="12sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="📱 Local"
            app:chipIcon="@drawable/ic_local"
            app:chipIconTint="@color/brand"
            app:chipBackgroundColor="@color/brand_light"
            android:textColor="@color/brand_dark"
            app:chipStrokeWidth="0dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 words • 0 chars"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Color Palette Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <!-- Note Title -->
    <EditText
        android:id="@+id/noteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/note_title_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:background="@null"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:textColor="@color/on_surface"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Attached Images Horizontal Scroll -->
    <HorizontalScrollView
        android:id="@+id/imagesScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/imagesContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Voice Memo Player Bar -->
    <LinearLayout
        android:id="@+id/voiceMemoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:background="@color/brand_light"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnVoicePlayPause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_play"
            app:tint="@color/brand"
            android:contentDescription="Play/Pause Voice" />

        <TextView
            android:id="@+id/tvVoiceTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Voice Memo (00:00)"
            android:textColor="@color/brand_dark"
            android:textStyle="bold"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btnVoiceDelete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/brand"
            android:contentDescription="Delete Voice Memo" />
    </LinearLayout>

    <!-- Live Recording Bar -->
    <LinearLayout
        android:id="@+id/recordingLiveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:background="#FFEBEE"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_mic"
            app:tint="#D32F2F"
            android:contentDescription="Recording Active" />

        <TextView
            android:id="@+id/tvRecordingDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Recording Voice... 00:00"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnStopRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="■ Stop &amp; Save"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Note Content Area -->
    <EditText
        android:id="@+id/noteContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:hint="@string/note_content_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingMultiplier="1.25"
        android:background="@null"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:textColor="@color/on_surface"
        android:textSize="16sp" />

    <!-- Bottom Formatting Toolbar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color" />

    <HorizontalScrollView
        android:id="@+id/formattingToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/toolbar_bg"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnAddImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add Photo"
                android:src="@drawable/ic_image"
                app:tint="@color/brand" />

            <ImageButton
                android:id="@+id/btnRecordVoice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Record Voice"
                android:src="@drawable/ic_mic"
                app:tint="@color/brand" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/divider_color" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:src="@drawable/ic_undo"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:src="@drawable/ic_redo"
                app:tint="@color/on_surface" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/divider_color" />

            <ImageButton
                android:id="@+id/btnH1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Heading 1"
                android:src="@drawable/ic_format_h1"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnH2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Heading 2"
                android:src="@drawable/ic_format_h2"
                app:tint="@color/on_surface" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/divider_color" />

            <ImageButton
                android:id="@+id/btnBold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bold"
                android:src="@drawable/ic_format_bold"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnItalic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Italic"
                android:src="@drawable/ic_format_italic"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnUnderline"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Underline"
                android:src="@drawable/ic_format_underline"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnStrikethrough"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Strikethrough"
                android:src="@drawable/ic_format_strikethrough"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnHighlight"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Highlight"
                android:src="@drawable/ic_format_highlight"
                app:tint="@color/on_surface" />

            <ImageButton
                android:id="@+id/btnTextColor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Text Color"
                android:src="@drawable/ic_format_color_text"
                app:tint="@color/on_surface" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@color/divider_color" />

            <ImageButton
                android:id="@+id/btnBullet"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Bullet list"
                android:src="@drawable/ic_format_list_bulleted"
                app:tint="@color/on_surface" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
