# AANO Cloudflare Worker - Environment Variables Example
# Add these variables in Cloudflare Dashboard:
# Workers & Pages -> aano-api -> Settings -> Variables -> Environment Variables (Click 'Encrypt' on each!)

# 1. Your Google Apps Script Web App URL
MAIL_BRIDGE_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# 2. Secret shared between Cloudflare Worker and Google Apps Script
MAIL_BRIDGE_SECRET="your_custom_bridge_secret_here"

# 3. Client Handshake Key (Sent via X-AANO-KEY header from app)
SECRET_APP_KEY="your_custom_app_handshake_key_here"
